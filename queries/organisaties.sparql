# Organisaties (schema:Organization) uit de RCE Muurschilderingendatabase --
# ateliers/restauratiebedrijven, gekoppeld via dcterms:creator op
# schema:Painting (zie queries/paintings.sparql). Klein aantal (6
# landelijk), zie queries/personen.sparql voor het persoonequivalent.

PREFIX schema: <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?s ?titel ?beschrijving ?sameAs WHERE {
  GRAPH ?g {
    ?s a schema:Organization .
    OPTIONAL { ?s dcterms:title ?titel }
    OPTIONAL { ?s dcterms:description ?beschrijving }
    OPTIONAL { ?s schema:sameAs ?sameAs }
  }
}
